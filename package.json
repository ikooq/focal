    "ical.js": "^2.2.1",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "shadcn": "4.23.1",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.6"
